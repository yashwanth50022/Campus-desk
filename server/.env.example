# Copy to server/.env; keep credentials out of source control.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_erp?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
JWT_REFRESH_SECRET="replace-with-a-different-32-byte-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
ACADEMIC_YEAR_START=2026
# Demo seed only; set a unique temporary password (12+ characters).
DEMO_PASSWORD="replace-with-a-unique-strong-demo-password"
# Password reset email. Without SMTP, the OTP is logged only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="College ERP <no-reply@example.edu>"
